"NSMotionUsageDescription" = "يستخدم NATURaL بيانات حركة AirPods للحفاظ على توافق الصوت المكاني مع اتجاه رأسك أثناء يوغا الكرسي. تبقى بيانات الحركة على هذا الجهاز.";
"NSCameraUsageDescription" = "يستخدم NATURaL الكاميرا لتقديم إرشاد اختياري للوضعيات بالواقع المعزز على الجهاز. يُعالَج الفيديو على هذا الجهاز ولا يتم رفعه مطلقًا.";
"NSAppleMusicUsageDescription" = "يشغّل NATURaL موسيقى متكيفة أثناء جلسات يوغا الكرسي ويضبط الإيقاع والطابع الحماسي وفقًا للتغذية الراجعة الحيوية لديك.";
"NSHealthShareUsageDescription" = "يقرأ NATURaL معدل نبض القلب وتباينه وبيانات النوم والنشاط لحساب مؤشر انهيار شانون وتكييف الجلسة في الوقت الفعلي. وبموافقتك الصريحة فقط، قد يقرأ أيضًا سجلات الأدوية السريرية التي ربطتها بتطبيق صحتي لمساعدتك في إدارة الوصفات التي أدخلتها بنفسك. لا تتم القراءة دون موافقتك، ولا تُقدَّم هذه المعلومات بوصفها نصيحة طبية.";
"NSHealthUpdateUsageDescription" = "يحفظ NATURaL جلسات اليوغا المكتملة كتدريبات وجلسات يقظة ذهنية لتظهر في تطبيقي صحتي واللياقة البدنية.";
"NSHealthClinicalHealthRecordsShareUsageDescription" = "بموافقتك الصريحة، يستورد NATURaL سجلات الأدوية من المؤسسات التي ربطتها بتطبيق صحتي لإدارة التذكيرات ومهام CareKit. أنت من يدير هذه البيانات، وهي ليست نصيحة طبية. أكّد جميع الوصفات مع المختص المعالج. لا يسجّل NATURaL الدخول إلى حسابات الصيدليات ولا يستخرج المحتوى من مواقعها.";
"NSLocalNetworkUsageDescription" = "يستخدم NATURaL الشبكة المحلية لبث عرض تمرينك إلى Apple TV عبر Bonjour.";
