<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- HealthKit stays on the user's device / Apple Health. NATURaL does not collect it. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.background-delivery</key>
	<true/>
	<!-- com.apple.developer.healthkit.access (health-records) was removed for 1.0.
	     Clinical medication records are cut from this release; the code is retained and
	     gated behind HealthKitManager.clinicalMedicationRecordsEnabled. Restoring the
	     feature requires restoring this entitlement as well as flipping that flag.
	     Rationale: Docs/AppStore/clinical-records-cut-from-1-0.md -->

	<!-- App Groups: on-device widget and Live Activity state only. No cloud container. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.natural.Bonhomme</string>
	</array>

	<!-- Siri / App Intents: on-device workout shortcuts. -->
	<key>com.apple.developer.siri</key>
	<true/>

	<!-- Push is used only for local Live Activities (Dynamic Island / Lock Screen). -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
